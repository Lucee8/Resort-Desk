{
  "name": "resortdesk-mykonos-functions",
  "version": "1.0.0",
  "description": "Firebase Cloud Functions (asia-south1) for Mykonos Cottage, Tarkarli WhatsApp Cloud API & Email Delivery",
  "main": "lib/index.js",
  "scripts": {
    "lint": "tsc --noEmit",
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "deploy": "firebase deploy --only functions"
  },
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "firebase-admin": "^13.2.0",
    "firebase-functions": "^6.3.2",
    "nodemailer": "^6.10.1"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^6.4.17",
    "typescript": "^5.8.2"
  },
  "private": true
}
